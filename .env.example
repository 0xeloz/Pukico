# Site URL for canonical and og:url (tanpa trailing slash)
VITE_SITE_URL="https://domain-kamu.com"

# Supabase Edge Functions configuration for username check & waitlist
VITE_SUPABASE_URL="https://your-project.supabase.co"
# Boleh menggunakan Supabase publishable key (sb_publishable_...) atau anon key
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Community links (opsional: jika dikosongkan, tombol/link tidak akan dirender)
VITE_DISCORD_INVITE_URL="https://discord.gg/ISI_INVITE_KAMU"
VITE_X_URL="https://x.com/ISI_USERNAME_KAMU"

